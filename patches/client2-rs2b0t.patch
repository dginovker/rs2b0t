@@ -0,0 +1,72 @@
+import { sleep } from './JsUtil.js';
+
+const WORKER_SRC = `
+const timers = new Map();
+onmessage = (e) => {
+    const d = e.data;
+    if (d.cancel !== undefined) {
+        const t = timers.get(d.cancel);
+        if (t !== undefined) { clearTimeout(t); timers.delete(d.cancel); }
+        return;
